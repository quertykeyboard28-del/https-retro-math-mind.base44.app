# Copy to .env locally and populate with secrets outside version control.
CHAT_PROVIDER=wici
WICI_BASE_URL=http://wici.local:8787
WICI_DEVICE_TOKEN=replace-with-a-new-paired-device-token
WICI_MODEL=wici-assistant
# For Gemini, set CHAT_PROVIDER=gemini, then supply a current model ID from official docs.
GEMINI_API_KEY=replace-with-a-new-Gemini-key
GEMINI_MODEL=replace-with-current-supported-model-id
# Optional
# UPLOAD_FOLDER=/private/path/uploads
# MAX_UPLOAD_BYTES=10485760
